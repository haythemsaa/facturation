# ============================================
# TUNISBUSINESS SUITE - PRODUCTION ENVIRONMENT
# ============================================
# Version: 1.0.0
# Last Updated: 2025-11-19
#
# SECURITY WARNING:
# - NEVER commit this file with real credentials
# - Generate strong passwords for all services
# - Rotate secrets regularly
# - Use environment-specific values

# ============================================
# APPLICATION
# ============================================
APP_NAME="TunisBusiness Suite"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_TIMEZONE=Africa/Tunis
APP_URL=https://api.tunisbusiness.tn

# Locale
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_SUPPORTED_LOCALES=fr,ar,en

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Server
PHP_CLI_SERVER_WORKERS=8

# Security
BCRYPT_ROUNDS=12
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAYS=14

# ============================================
# DATABASE - PostgreSQL
# ============================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=facturation_prod
DB_USERNAME=tunisbusiness_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_HERE

# Connection pool
DB_MAX_CONNECTIONS=100
DB_IDLE_TIMEOUT=60

# ============================================
# REDIS - Cache & Queues
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_HERE
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ============================================
# CACHE
# ============================================
CACHE_DRIVER=redis
CACHE_PREFIX=tunisbusiness_cache
CACHE_TTL=3600

# ============================================
# SESSION
# ============================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.tunisbusiness.tn
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================
# QUEUE
# ============================================
QUEUE_CONNECTION=redis
QUEUE_PREFIX=tunisbusiness

# Queue workers (supervisor config)
QUEUE_WORKERS=3
QUEUE_MAX_TIME=3600
QUEUE_TRIES=3
QUEUE_BACKOFF=30

# ============================================
# BROADCAST
# ============================================
BROADCAST_CONNECTION=redis
BROADCAST_DRIVER=redis

# ============================================
# FILESYSTEM
# ============================================
FILESYSTEM_DISK=s3
FILESYSTEM_DRIVER=s3

# AWS S3 (for production file storage)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=tunisbusiness-prod-storage
AWS_URL=https://tunisbusiness-prod-storage.s3.eu-west-1.amazonaws.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Local backup (if not using S3)
BACKUP_DISK=local
BACKUP_PATH=storage/app/backups

# ============================================
# MAIL - SMTP Production
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@mg.tunisbusiness.tn
MAIL_PASSWORD=YOUR_MAILGUN_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tunisbusiness.tn
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun (recommended for production)
MAILGUN_DOMAIN=mg.tunisbusiness.tn
MAILGUN_SECRET=YOUR_MAILGUN_SECRET_KEY
MAILGUN_ENDPOINT=api.eu.mailgun.net

# Alternative: SendGrid
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY

# Alternative: Amazon SES
# MAIL_MAILER=ses
# AWS_SES_REGION=eu-west-1

# ============================================
# MEMCACHED (Optional)
# ============================================
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# ============================================
# SECURITY
# ============================================
# Password policy
PASSWORD_EXPIRES_DAYS=90
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Session
SESSION_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_TIMEOUT=480

# Two-factor authentication
ENABLE_2FA=true
2FA_ISSUER="${APP_NAME}"

# IP Whitelist (comma-separated, optional)
IP_WHITELIST=

# Trusted proxies
TRUSTED_PROXIES=*

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
CORS_ALLOWED_ORIGINS=https://app.tunisbusiness.tn,https://dashboard.tunisbusiness.tn
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization
CORS_MAX_AGE=3600
CORS_SUPPORTS_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_STRICT=10
RATE_LIMIT_RELAXED=200
RATE_LIMIT_UNLIMITED=10000

# API throttle per minute
API_RATE_LIMIT=60
API_RATE_LIMIT_LOGIN=10

# ============================================
# TUNISBUSINESS SUITE - BUSINESS CONFIG
# ============================================

# PDF Generation
PDF_ORIENTATION=portrait
PDF_PAPER_SIZE=a4
PDF_DPI=96
PDF_ENABLE_REMOTE=false
PDF_ENABLE_JAVASCRIPT=false
PDF_ENABLE_HTML5_PARSER=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=02:00
BACKUP_NOTIFICATION_EMAIL=admin@tunisbusiness.tn
BACKUP_S3_BUCKET=tunisbusiness-backups-prod

# Webhooks
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5
WEBHOOK_TIMEOUT=30
WEBHOOK_SECRET_LENGTH=64

# Notifications
NOTIFICATION_QUEUE=notifications
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_RETENTION_DAYS=90

# Audit Logs
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_QUEUE=audit
AUDIT_LOG_ASYNC=true

# Stock Management
LOW_STOCK_THRESHOLD=10
ENABLE_STOCK_ALERTS=true
STOCK_ALERT_EMAIL=stock@tunisbusiness.tn

# ============================================
# TUNISIAN FISCAL SETTINGS
# ============================================
DEFAULT_TVA_RATE=19.00
APPLY_TIMBRE_FISCAL=true
MAX_TIMBRE_FISCAL=1.00
TIMBRE_FISCAL_RATE=1.00
TIMBRE_FISCAL_THRESHOLD=0.00

# TVA Rates
TVA_RATE_NORMAL=19.00
TVA_RATE_REDUCED_1=13.00
TVA_RATE_REDUCED_2=7.00
TVA_RATE_ZERO=0.00

# ============================================
# CRM SETTINGS
# ============================================
TOUR_CHECK_IN_RADIUS=100
ENABLE_TOUR_GEOLOCATION=true
TOUR_GPS_ACCURACY_THRESHOLD=50

# Sales pipeline stages
PIPELINE_STAGES=new,qualified,proposal,negotiation,won,lost

# Lead scoring
LEAD_SCORING_ENABLED=true
LEAD_SCORING_THRESHOLD=70

# ============================================
# HR & PAYROLL - TUNISIA
# ============================================

# CNSS (Social Security)
CNSS_RATE_EMPLOYEE=9.18
CNSS_RATE_EMPLOYER=16.57
CNSS_CEILING_MONTHLY=6000.000

# Other employer contributions
CSS_RATE=1.00
TFP_RATE=1.00
FOPROLOS_RATE=1.00

# Payroll
AUTO_LOCK_PAYSLIPS=true
PAYSLIP_LOCK_DELAY_DAYS=7
MINIMUM_WAGE_SMIG=460.000
MINIMUM_WAGE_SMAG=15.050

# Working hours
LEGAL_WORKING_HOURS_WEEKLY=40
LEGAL_WORKING_HOURS_DAILY=8

# Leave (congés)
ANNUAL_LEAVE_DAYS=12
SICK_LEAVE_MAX_DAYS_PAID=30

# IRPP 2025 (Tunisian tax brackets)
IRPP_ENABLED=true
IRPP_FAMILY_HEAD_DEDUCTION=300.000
IRPP_CHILD_DEDUCTION=100.000
IRPP_MAX_CHILDREN_DEDUCTION=4

# ============================================
# MONITORING & PERFORMANCE
# ============================================

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_CACHE_TTL=60
HEALTH_CHECK_TIMEOUT=5

# APM (Application Performance Monitoring)
# New Relic
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME="${APP_NAME}"

# Sentry (Error tracking)
SENTRY_LARAVEL_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# Scout (Search - Algolia/Meilisearch)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=YOUR_MEILISEARCH_MASTER_KEY

# ============================================
# PAYMENT GATEWAYS (if applicable)
# ============================================

# Stripe
STRIPE_KEY=pk_live_YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Clictopay (Tunisian gateway)
CLICTOPAY_AFFILIATE_CODE=YOUR_AFFILIATE_CODE
CLICTOPAY_USER_ID=YOUR_USER_ID
CLICTOPAY_PASSWORD=YOUR_PASSWORD
CLICTOPAY_ENVIRONMENT=production

# ============================================
# SMS GATEWAY (Optional)
# ============================================
SMS_DRIVER=tunisie_telecom
SMS_FROM="TunisBiz"
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_API_SECRET=YOUR_SMS_API_SECRET

# ============================================
# SCHEDULER & CRON
# ============================================
SCHEDULER_TIMEZONE=Africa/Tunis

# Backup schedule
BACKUP_SCHEDULE=0 2 * * *

# Cleanup schedules
CLEANUP_AUDIT_LOGS_SCHEDULE=0 3 * * 0
CLEANUP_NOTIFICATIONS_SCHEDULE=0 4 * * 0
CLEANUP_TEMP_FILES_SCHEDULE=0 5 * * *

# Stock alerts schedule
STOCK_ALERTS_SCHEDULE=0 10 * * *

# Subscription alerts schedule
SUBSCRIPTION_ALERTS_SCHEDULE=0 9 * * *

# ============================================
# DOCKER & DEPLOYMENT
# ============================================
APP_PORT=80
APP_SSL_PORT=443

COMPOSE_PROJECT_NAME=tunisbusiness
DOCKER_RESTART_POLICY=always

# Resource limits (Docker)
APP_MEMORY_LIMIT=2G
APP_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=2G
REDIS_MEMORY_LIMIT=512M

# ============================================
# ANALYTICS (Optional)
# ============================================
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
FACEBOOK_PIXEL_ID=

# ============================================
# VITE (Frontend build tool)
# ============================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================
# ADDITIONAL SERVICES
# ============================================

# Pusher (WebSockets - for real-time features)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

# Alternative: Laravel Echo Server
ECHO_SERVER_HOST=echo.tunisbusiness.tn
ECHO_SERVER_PORT=6001
ECHO_SERVER_PROTOCOL=https

# ============================================
# NOTES & REMINDERS
# ============================================
#
# 1. Generate APP_KEY:
#    php artisan key:generate --show
#
# 2. Strong Passwords:
#    - Use passwords with 32+ characters
#    - Mix uppercase, lowercase, numbers, symbols
#    - Never reuse passwords across services
#
# 3. SSL Certificates:
#    - Use Let's Encrypt (free)
#    - Or commercial SSL (Comodo, DigiCert)
#    - Auto-renewal with certbot
#
# 4. Firewall:
#    - Allow ports: 80, 443, 22 (SSH)
#    - Block all other inbound ports
#    - Use fail2ban for brute-force protection
#
# 5. Backups:
#    - Daily automated backups at 02:00
#    - Test restore procedure monthly
#    - Keep offsite backups (S3, Glacier)
#
# 6. Monitoring:
#    - Set up Sentry for error tracking
#    - Use New Relic or Datadog for APM
#    - Configure alerts for critical errors
#
# 7. Performance:
#    - Enable OPcache in php.ini
#    - Use Redis for cache/sessions/queues
#    - Consider CDN for static assets
#
# 8. Security Checklist:
#    ✅ APP_DEBUG=false
#    ✅ Strong passwords for all services
#    ✅ HTTPS enforced (HSTS)
#    ✅ CORS properly configured
#    ✅ Rate limiting enabled
#    ✅ Firewall configured
#    ✅ Regular security updates
#    ✅ Audit logs enabled
#
# 9. Compliance (Tunisia):
#    - RGPD/GDPR if handling EU data
#    - Tunisian data protection law
#    - Tax compliance (TVA, IRPP, CNSS)
#    - Electronic invoicing regulations
#
# 10. Support:
#     Email: support@tunisbusiness.tn
#     Docs: https://docs.tunisbusiness.tn
#     Status: https://status.tunisbusiness.tn
