APP_NAME="TunisBusiness Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Tunis
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_SUPPORTED_LOCALES=fr,ar,en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=facturation
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# TUNISBUSINESS SUITE CONFIGURATION
# ============================================

# Backup Configuration
BACKUP_PATH=storage/app/backups
BACKUP_RETENTION_DAYS=30

# PDF Generation
PDF_ORIENTATION=portrait
PDF_PAPER_SIZE=a4
PDF_DPI=96

# Rate Limiting
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_STRICT=10
RATE_LIMIT_RELAXED=200
RATE_LIMIT_UNLIMITED=10000

# Webhooks
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5
WEBHOOK_TIMEOUT=30

# Notifications
NOTIFICATION_QUEUE=notifications
NOTIFICATION_BATCH_SIZE=100

# Audit Logs
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_ENABLED=true

# Stock Management
LOW_STOCK_THRESHOLD=10
ENABLE_STOCK_ALERTS=true

# Tunisian Fiscal Settings
DEFAULT_TVA_RATE=19.00
APPLY_TIMBRE_FISCAL=true
MAX_TIMBRE_FISCAL=1.00
TIMBRE_FISCAL_RATE=1.00

# CRM Settings
TOUR_CHECK_IN_RADIUS=100
ENABLE_TOUR_GEOLOCATION=true

# HR & Payroll
CNSS_RATE_EMPLOYEE=9.18
CNSS_RATE_EMPLOYER=16.57
AUTO_LOCK_PAYSLIPS=true

# Security
PASSWORD_EXPIRES_DAYS=90
SESSION_TIMEOUT_MINUTES=120
ENABLE_2FA=false

# CORS (Cross-Origin Resource Sharing)
# Comma-separated list of allowed origins, or * for all
# Production: https://app.tunisbusiness.tn,https://dashboard.tunisbusiness.tn
CORS_ALLOWED_ORIGINS=*
